@page "/dosen"
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using System.Linq
@inject HttpClient Http

<PageTitle>Data Dosen</PageTitle>

<div class="container-fluid py-3">
    <h1>Data Dosen</h1>
    <p class="text-muted">Kelola data dosen AcademicAPI.</p>

    @if (!string.IsNullOrWhiteSpace(notifikasi))
    {
        <div class="alert @(berhasil ? "alert-success" : "alert-danger")">
            @notifikasi
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">
                @(modeEdit ? "Edit Dosen" : "Tambah Dosen")
            </h5>

            <EditForm Model="formDosen" OnValidSubmit="SimpanDosen">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">NIDN</label>
                        <InputText class="form-control"
                                   @bind-Value="formDosen.Nidn" />
                        <ValidationMessage For="@(() => formDosen.Nidn)" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Nama Dosen</label>
                        <InputText class="form-control"
                                   @bind-Value="formDosen.NamaDosen" />
                        <ValidationMessage For="@(() => formDosen.NamaDosen)" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Email</label>
                        <InputText class="form-control"
                                   @bind-Value="formDosen.Email" />
                        <ValidationMessage For="@(() => formDosen.Email)" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Program Studi</label>
                        <InputText class="form-control"
                                   @bind-Value="formDosen.Prodi" />
                        <ValidationMessage For="@(() => formDosen.Prodi)" />
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@sedangMenyimpan">
                        @(sedangMenyimpan
                                                ? "Menyimpan..."
                                                : modeEdit
                                                ? "Simpan Perubahan"
                                                : "Tambah Dosen")
                    </button>

                    @if (modeEdit)
                    {
                        <button type="button"
                                class="btn btn-secondary"
                                disabled="@sedangMenyimpan"
                                @onclick="BatalEdit">
                            Batal
                        </button>
                    }
                </div>
            </EditForm>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <h5 class="mb-0">Daftar Dosen</h5>

                <button class="btn btn-outline-primary btn-sm"
                        disabled="@sedangMemuat"
                        @onclick="MuatDosen">
                    Muat Ulang
                </button>
            </div>

            <div class="mb-3">
                <input class="form-control"
                       placeholder="Cari NIDN, nama dosen, email, atau program studi..."
                       @bind="kataKunci"
                       @bind:event="oninput"
                       @bind:after="ResetHalaman" />
            </div>

            @if (sedangMemuat)
            {
                <p>Memuat data dosen...</p>
            }
            else if (!string.IsNullOrWhiteSpace(errorMuat))
            {
                <div class="alert alert-danger">
                    @errorMuat
                </div>
            }
            else if (dosen.Count == 0)
            {
                <p>Belum ada data dosen.</p>
            }
            else if (!dosenTersaring.Any())
            {
                <div class="alert alert-info">
                    Data dosen tidak ditemukan.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>
                                    <button type="button"
                                            class="btn btn-link p-0 text-dark text-decoration-none fw-bold"
                                            @onclick='() => Urutkan("Nidn")'>
                                        NIDN @(kolomUrut == "Nidn"
                                                                            ? (urutanNaik ? "↑" : "↓")
                                                                            : "")
                                </button>
                            </th>

                                <th>
                                    <button type="button"
                                            class="btn btn-link p-0 text-dark text-decoration-none fw-bold"
                                            @onclick='() => Urutkan("NamaDosen")'>
                                        Nama Dosen @(kolomUrut == "NamaDosen"
                                                                        ? (urutanNaik ? "↑" : "↓")
                                                                        : "")
                                </button>
                            </th>

                                <th>
                                    <button type="button"
                                            class="btn btn-link p-0 text-dark text-decoration-none fw-bold"
                                            @onclick='() => Urutkan("Email")'>
                                        Email @(kolomUrut == "Email"
                                                                        ? (urutanNaik ? "↑" : "↓")
                                                                        : "")
                                </button>
                            </th>

                                <th>
                                    <button type="button"
                                            class="btn btn-link p-0 text-dark text-decoration-none fw-bold"
                                            @onclick='() => Urutkan("Prodi")'>
                                        Program Studi @(kolomUrut == "Prodi"
                                                                        ? (urutanNaik ? "↑" : "↓")
                                                                        : "")
                                </button>
                            </th>

                                <th>Aksi</th>
                            </tr>
                        </thead>

                        <tbody>
                        @foreach (var item in dosenPerHalaman)
                            {
                                <tr @key="item.DosenId">
                                    <td>@item.Nidn</td>
                                    <td>@item.NamaDosen</td>
                                    <td>@item.Email</td>
                                    <td>@item.Prodi</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-warning btn-sm"
                                                    disabled="@sedangMenyimpan"
                                                    @onclick="() => MulaiEdit(item)">
                                                Edit
                                            </button>

                                            <button class="btn btn-danger btn-sm"
                                                    disabled="@sedangMenyimpan"
                                                    @onclick="() => HapusDosen(item)">
                                                Hapus
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                    <span class="text-muted">
                        Halaman @halamanSaatIni dari @totalHalaman
                        — Total @dosenTersaring.Count() data
                    </span>

                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm"
                                disabled="@(halamanSaatIni <= 1)"
                                @onclick="HalamanSebelumnya">
                            Sebelumnya
                        </button>

                        <button class="btn btn-outline-primary btn-sm"
                                disabled="@(halamanSaatIni >= totalHalaman)"
                                @onclick="HalamanBerikutnya">
                            Berikutnya
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<DosenDto> dosen = new();
    private string kataKunci = "";

    private string kolomUrut = "NamaDosen";
    private bool urutanNaik = true;

    private int halamanSaatIni = 1;
    private int jumlahPerHalaman = 5;

    private IEnumerable<DosenDto> dosenTersaring =>
        dosen.Where(d =>
            (d.Nidn ?? "").Contains(
                kataKunci ?? "", StringComparison.OrdinalIgnoreCase) ||
            (d.NamaDosen ?? "").Contains(
                kataKunci ?? "", StringComparison.OrdinalIgnoreCase) ||
            (d.Email ?? "").Contains(
                kataKunci ?? "", StringComparison.OrdinalIgnoreCase) ||
            (d.Prodi ?? "").Contains(
                kataKunci ?? "", StringComparison.OrdinalIgnoreCase));

    private IEnumerable<DosenDto> dosenTerurut =>
        kolomUrut switch
        {
            "Nidn" => urutanNaik
                ? dosenTersaring.OrderBy(d => d.Nidn)
                : dosenTersaring.OrderByDescending(d => d.Nidn),

            "NamaDosen" => urutanNaik
                ? dosenTersaring.OrderBy(d => d.NamaDosen)
                : dosenTersaring.OrderByDescending(d => d.NamaDosen),

            "Email" => urutanNaik
                ? dosenTersaring.OrderBy(d => d.Email)
                : dosenTersaring.OrderByDescending(d => d.Email),

            "Prodi" => urutanNaik
                ? dosenTersaring.OrderBy(d => d.Prodi)
                : dosenTersaring.OrderByDescending(d => d.Prodi),

            _ => dosenTersaring.OrderBy(d => d.NamaDosen)
        };

    private int totalHalaman =>
        Math.Max(1, (int)Math.Ceiling(
            dosenTersaring.Count() / (double)jumlahPerHalaman));

    private IEnumerable<DosenDto> dosenPerHalaman =>
        dosenTerurut
            .Skip((halamanSaatIni - 1) * jumlahPerHalaman)
            .Take(jumlahPerHalaman);

    private void Urutkan(string kolom)
    {
        if (kolomUrut == kolom)
        {
            urutanNaik = !urutanNaik;
        }
        else
        {
            kolomUrut = kolom;
            urutanNaik = true;
        }

        halamanSaatIni = 1;
    }

    private FormDosen formDosen = new();

    private int idEdit;
    private bool modeEdit;
    private bool sedangMemuat;
    private bool sedangMenyimpan;
    private bool berhasil;
    private string? notifikasi;
    private string? errorMuat;

    protected override async Task OnInitializedAsync()
    {
        await MuatDosen();
    }

    private async Task MuatDosen()
    {
        sedangMemuat = true;
        errorMuat = null;

        try
        {
            dosen = await Http.GetFromJsonAsync<List<DosenDto>>("api/Dosen")
                    ?? new List<DosenDto>();

            PeriksaHalaman();
        }
        catch (Exception)
        {
            errorMuat = "Gagal memuat data dosen. Pastikan AcademicAPI berjalan.";
        }
        finally
        {
            sedangMemuat = false;
        }
    }

    private void HalamanSebelumnya()
    {
        if (halamanSaatIni > 1)
        {
            halamanSaatIni--;
        }
    }

    private void HalamanBerikutnya()
    {
        if (halamanSaatIni < totalHalaman)
        {
            halamanSaatIni++;
        }
    }

    private void ResetHalaman()
    {
        halamanSaatIni = 1;
    }

    private void PeriksaHalaman()
    {
        if (halamanSaatIni > totalHalaman)
        {
            halamanSaatIni = totalHalaman;
        }

        if (halamanSaatIni < 1)
        {
            halamanSaatIni = 1;
        }
    }

    private async Task SimpanDosen()
    {
        if (sedangMenyimpan)
            return;

        sedangMenyimpan = true;
        notifikasi = null;

        try
        {
            HttpResponseMessage respons;

            if (modeEdit)
            {
                respons = await Http.PutAsJsonAsync(
                    $"api/Dosen/{idEdit}", formDosen);
            }
            else
            {
                respons = await Http.PostAsJsonAsync(
                    "api/Dosen", formDosen);
            }

            if (respons.IsSuccessStatusCode)
            {
                berhasil = true;
                notifikasi = modeEdit
                    ? "Data dosen berhasil diperbarui."
                    : "Dosen baru berhasil ditambahkan.";

                modeEdit = false;
                idEdit = 0;
                formDosen = new FormDosen();

                await MuatDosen();
            }
            else
            {
                berhasil = false;
                var isi = await respons.Content.ReadAsStringAsync();

                notifikasi = respons.StatusCode ==
                             System.Net.HttpStatusCode.Conflict
                    ? "NIDN sudah digunakan. Periksa kembali NIDN."
                    : $"Gagal menyimpan data. {isi}";
            }
        }
        catch (Exception)
        {
            berhasil = false;
            notifikasi = "Tidak dapat terhubung ke AcademicAPI.";
        }
        finally
        {
            sedangMenyimpan = false;
        }
    }

    private void MulaiEdit(DosenDto item)
    {
        idEdit = item.DosenId;
        modeEdit = true;

        formDosen = new FormDosen
        {
            Nidn = item.Nidn,
            NamaDosen = item.NamaDosen,
            Email = item.Email,
            Prodi = item.Prodi
        };

        notifikasi = null;
    }

    private void BatalEdit()
    {
        modeEdit = false;
        idEdit = 0;
        formDosen = new FormDosen();
        notifikasi = null;
    }

    private async Task HapusDosen(DosenDto item)
    {
        if (sedangMenyimpan)
            return;

        bool konfirmasi = await Application.Current!
            .Windows[0].Page!.DisplayAlert(
                "Konfirmasi Hapus",
                $"Apakah kamu yakin ingin menghapus dosen {item.NamaDosen}?",
                "Hapus",
                "Batal");

        if (!konfirmasi)
            return;

        sedangMenyimpan = true;
        notifikasi = null;

        try
        {
            var respons = await Http.DeleteAsync(
                $"api/Dosen/{item.DosenId}");

            if (respons.IsSuccessStatusCode)
            {
                berhasil = true;
                notifikasi = "Data dosen berhasil dihapus.";
                await MuatDosen();
            }
            else
            {
                berhasil = false;
                var isi = await respons.Content.ReadAsStringAsync();

                notifikasi = respons.StatusCode ==
                             System.Net.HttpStatusCode.Conflict
                    ? "Dosen tidak bisa dihapus karena masih menjadi dosen wali mahasiswa."
                    : $"Gagal menghapus dosen. {isi}";
            }
        }
        catch (Exception)
        {
            berhasil = false;
            notifikasi = "Tidak dapat terhubung ke AcademicAPI.";
        }
        finally
        {
            sedangMenyimpan = false;
        }
    }

    public class DosenDto
    {
        public int DosenId { get; set; }
        public string Nidn { get; set; } = "";
        public string NamaDosen { get; set; } = "";
        public string Email { get; set; } = "";
        public string Prodi { get; set; } = "";
    }

    public class FormDosen
    {
        [Required(ErrorMessage = "NIDN wajib diisi.")]
        public string Nidn { get; set; } = "";

        [Required(ErrorMessage = "Nama dosen wajib diisi.")]
        public string NamaDosen { get; set; } = "";

        [Required(ErrorMessage = "Email wajib diisi.")]
        [EmailAddress(ErrorMessage = "Format email tidak valid.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Program studi wajib diisi.")]
        public string Prodi { get; set; } = "";
    }
}